JIRA_BASE_URL=https://jira.tricolor.tv
JIRA_USERNAME=integration-user
JIRA_PASSWORD=change-me

# Можно переопределить без изменения исходного кода.
JIRA_ODS_JQL=project = ODS AND assignee = currentUser() AND status not in (Done, Closed, "Выполнено", "Закрыто") ORDER BY updated DESC
JIRA_SSIS_JQL=status not in (Done, Closed, "Выполнено", "Закрыто") AND ("Customer Request Type" in ("Корпоративный портал_OLD", "Корпоративный портал (SSIS)") OR cf[10866] = "Корпоративный портал Битрикс24 (СУРВ)") ORDER BY created DESC, updated DESC
